        printf("\n---Digite um vetorA---\n");
    for(i = 0; i < 10; i++){
        printf("Posição:%d\n",i + 1);
        scanf("%d",&vetorA[i]);
    }
    for(i = 0; i < 10;i++){
        vetorB[i] = vetorA[ 9 -1 -i ] ; 
    }
    for( i = 0; i < 10; i++){
        vetorC[i] = (vetorA[i] * 3) - vetorB[i];
    }
     printf("\n--- RESULTADOS ---\n");
    printf("Vetor A: ");
    for (i = 0; i < 10; i++) {
        printf("%4d ", vetorA[i]);
    }

    printf("\nVetor B: ");
    for (i = 0; i < 10; i++) {
        printf("%4d ", vetorB[i]);
    }

    printf("\nVetor C: ");
    for (i = 0; i < 10; i++) {
        printf("%4d ", vetorC[i]);
    }
    printf("\n");
}


