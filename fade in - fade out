const int ledPin = 9; 

void setup() {
  pinMode(ledPin, OUTPUT);
}

void loop() {
  // Fade-in: Aumenta o brilho gradualmente durante 1 segundo
  for (int brightness = 0; brightness <= 255; brightness++) {
    analogWrite(ledPin, brightness);
    delay(1000); // 1000000 microssegundos / 255 passos
  }

  // Fade-out: Diminui o brilho gradualmente durante 3 segundos
  for (int brightness = 255; brightness >= 0; brightness--) {
    analogWrite(ledPin, brightness);
    delay(3000); 
  }
}
